# HiAgent platform API base URL. Do not append a trailing slash.
# The browser's left-bottom API configuration can override this per browser.
HIAGENT_API_BASE_URL=https://ai.yznu.edu.cn/api/proxy/api/v1

# Enable API publication in the HiAgent platform, then generate and paste the API key here.
HIAGENT_API_KEY=replace-with-your-api-key

# Port for the local development server.
PORT=5173

# HiAgent Up service. Use the actual upload endpoint confirmed by operations.
# Both http://host:port and http://host:port/up are accepted.
HIAGENT_UP_ENDPOINT=
# direct: exposed bypass service, no AK/SK. v4: signed service. auto: infer from credentials.
HIAGENT_UP_AUTH_MODE=auto
HIAGENT_UP_ACCESS_KEY=
HIAGENT_UP_SECRET_KEY=
HIAGENT_UP_REGION=cn-north-1
HIAGENT_UP_SERVICE=up

# Optional for Top calls. Leave blank for a directly exposed Up service.
HIAGENT_UP_ACCOUNT_ID=
HIAGENT_UP_TIMEOUT_MS=90000
# Temporary attachment retention; empty means permanent storage (confirm policy first).
HIAGENT_UP_EXPIRE=3h

# Platform-readable download URL; do not use the short-lived DownloadKey URL.
HIAGENT_FILE_DOWNLOAD_URL=https://ai.yznu.edu.cn/api/proxy/down
